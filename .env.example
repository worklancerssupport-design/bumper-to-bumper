# All variables are server-only (no VITE_ prefix). Set the same values in Vercel's project settings.

# GitHub (edit console reads/writes data files through /api/github-file)
GITHUB_TOKEN=github_pat_xxxxx
GITHUB_OWNER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main

# /edit login
EDIT_USERNAME=admin
EDIT_PASSWORD=your-secure-password

# Signs /edit login tokens (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Cloudinary signed uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
